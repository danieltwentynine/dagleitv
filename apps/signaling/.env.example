PORT=4000
# Comma-separated allowed origins for CORS (the web app URL(s))
ALLOWED_ORIGINS=http://localhost:3000
# Cloudflare Realtime TURN (dashboard > Realtime > TURN). Leave unset for STUN only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Set to 1 when behind a reverse proxy so /ice rate limiting sees the real client IP.
TRUST_PROXY=0
# /ice requests allowed per client IP per window.
ICE_RATE_LIMIT=10
ICE_RATE_WINDOW_MS=60000
